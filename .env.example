# Admin login for /admin — change before deploying
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Optional: separate secret for signing admin sessions (any long random string)
ADMIN_SECRET=

# Public address of the site (used for link previews), e.g. https://www.pr-one.com
SITE_URL=http://localhost:3000

# Where the SQLite database and uploaded images are stored.
# On Coolify, mount a persistent volume at /app/data.
DATA_DIR=./data
